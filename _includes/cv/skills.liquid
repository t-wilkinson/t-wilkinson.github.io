{% comment %}
  Unified skills entry renderer for both formats
{% endcomment %}

<div class="card-text font-weight-light">
  {% for entry in entries %}
    <span class="skill-item">
      {% if entry.icon %}
        <i class="{{ entry.icon }}"></i>
      {% endif %}
      <strong>
        {{- entry.name -}}
        {%- if entry.level and false %} ({{ entry.level }}){% endif %}</strong
      >
      {% if entry.keywords %}
<span class="ml-1 text-muted" style="font-weight: normal;">
          : {{ entry.keywords | join: ", " }}
        </span>
        {% comment %}
        {% for keyword in entry.keywords %}
          {% if forloop.last %}
            {{ keyword }}
          {% else %}
            {{ keyword }},
          {% endif %}
        {% endfor %}
        {% endcomment %}
      {% endif %}
    </span>
  {% endfor %}
</div>

<style>
.skill-item {
  display: inline-flex;
  align-items: center;
  white-space: nowrap;

  background-color: #f0f2f5;
  border-radius: 50px;
  padding: 5px 15px;
  margin: 5px;

  font-size: 0.9rem;
  color: #333;
  border: 1px solid #d1d9e6;
  transition: all 0.2s ease;
}

.skill-item:hover {
  background-color: #e2e6ea;
  transform: translateY(-1px);
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.skill-item i {
  margin-right: 8px;
  color: var(--global-theme-color);
}
</style>
